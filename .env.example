# Open Notebook MCP Server Configuration

# Required: URL of your Open Notebook instance
OPEN_NOTEBOOK_URL=http://localhost:5055

# Optional: Authentication password (if APP_PASSWORD is set in Open Notebook)
# OPEN_NOTEBOOK_PASSWORD=your_password_here

# Optional: Transport mode (default: stdio)
# MCP_TRANSPORT=stdio

# Optional: HTTP server configuration (only used if MCP_TRANSPORT=streamable-http)
# HOST=127.0.0.1
# PORT=8000
# MCP_PATH=/mcp
# STATELESS_HTTP=1
# JSON_RESPONSE=1

# Streamable HTTP: required when MCP_TRANSPORT=streamable-http.
# Supply the actual value through your secret manager; do not commit it.
# MCP_AUTH_TOKEN=

# Host allowlist for Streamable HTTP; include the DNS names clients use to reach the server.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,open-notebook-mcp

# Requests that contain an Origin header are denied unless explicitly allowed.
# MCP_ALLOWED_ORIGINS=
